{
	"name": "agentic-engineering",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "prisma contract emit",
		"db:plan": "prisma migration plan",
		"db:migrate": "prisma db migrate",
		"db:status": "prisma migration status",
		"db:update": "prisma db update",
		"dev": "next dev",
		"postinstall": "prisma contract emit",
		"preview": "next build && next start",
		"start": "next start",
		"typecheck": "tsc --noEmit --incremental",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test --project=e2e",
		"test:components": "playwright test --project=components",
		"test:browser": "playwright test",
		"test:all": "pnpm test && pnpm test:browser",
		"test:gallery": "vite --config playwright/vite.config.ts",
		"scss": "pnpm typed-scss-modules src --watch --implementation sass --exportType default --nameFormat none && pnpm exec biome format --write --no-errors-on-unmatched src/**/*.scss.d.ts"
	},
	"dependencies": {
		"@prisma/orm-sqlite": "8.0.0-rc.18",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-query": "^5.104.2",
		"@trpc/client": "^11.19.0",
		"@trpc/server": "^11.19.0",
		"@trpc/tanstack-react-query": "^11.19.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv": "^18.0.8",
		"next": "^16.4.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"server-only": "^0.0.1",
		"superjson": "^2.2.6",
		"typed-scss-modules": "^8.1.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@vitejs/plugin-react": "^6.1.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"prisma": "8.0.0-rc.23",
		"sass": "^1.105.1",
		"typescript": "^7.0.2"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	},
	"packageManager": "pnpm@12.11.2"
}
